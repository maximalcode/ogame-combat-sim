# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Environment
.env
.env.local

# Node / Frontend
node_modules/
dist/
build/
.vite/
*.log
npm-debug.log*

# IDEs
.idea/
.vscode/
# Agent tooling. launch.json is shared and must stay machine-independent;
# settings.local.json is one machine's permission grants and is not.
.claude/settings.local.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
# Editor workspace files can reference private sibling repos — keep them out.
*.code-workspace
