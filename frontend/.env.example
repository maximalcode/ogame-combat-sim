# Frontend environment configuration.
#
# The API base URL. combat-api listens on PORT (default 3000); set this if your
# server runs elsewhere. When unset, the client falls back to same-origin
# requests, which the Vite dev server proxies to http://localhost:3000 — see
# vite.config.ts. So a local dev workflow needs none of this set.
#
# Copy to .env.local (gitignored) and edit:
#   VITE_API_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=
